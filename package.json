{
  "name": "dsh-model-meta-autofill",
  "version": "0.3.0",
  "description": "DSH plugin: auto-fill metadata (context length, output cap, display name, input modalities) for custom-provider models from the Model Metadata Registry (models.dev).",
  "keywords": [
    "dsh-plugin",
    "llm",
    "provider",
    "metadata",
    "context-window",
    "max-tokens",
    "models.dev",
    "publicproviderconf"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && node scripts/copy-data.mjs",
    "test": "tsx --test tests/dataset.spec.ts tests/enrich.spec.ts tests/integration/settings-autofill.spec.ts",
    "gen:data": "node --import tsx scripts/generate-snapshot.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=0.0.1-rc.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cosmokit": "1.8.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QJAG1024/dsh-model-meta-autofill.git"
  },
  "homepage": "https://github.com/QJAG1024/dsh-model-meta-autofill#readme",
  "bugs": {
    "url": "https://github.com/QJAG1024/dsh-model-meta-autofill/issues"
  }
}
