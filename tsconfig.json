{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "typeRoots": ["../../../deepseek-harness/node_modules/@types"],
    "noEmit": true,
    "paths": {
      "@deepseek-ai/cordis": ["../../../deepseek-harness/vendor/cordis"],
      "@deepseek-ai/cosmokit": ["../../../deepseek-harness/vendor/cosmokit"],
      "@deepseek-ai/schemastery": ["../../../deepseek-harness/vendor/schemastery"],
      "@deepseek-ai/dsh-settings": ["../../../deepseek-harness/packages/settings/settings"],
      "@deepseek-ai/dsh-settings/types": ["../../../deepseek-harness/packages/settings/settings"],
      "@deepseek-ai/dsh-brand": ["../../../deepseek-harness/packages/util/brand"],
      "@deepseek-ai/dsh-invariants": ["../../../deepseek-harness/packages/runtime-diagnostics/invariants"],
      "@deepseek-ai/dsh-host-webserver": ["../../../deepseek-harness/packages/host/webserver"],
      "@deepseek-ai/dsh-credentials": ["../../../deepseek-harness/packages/credentials/credentials"],
      "@deepseek-ai/dsh-llm-pi-ai": ["../../../deepseek-harness/packages/llm/llm-pi-ai"],
      "@deepseek-ai/dsh-settings-file": ["../../../deepseek-harness/packages/settings/settings-file"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "tests/**/*.mts"],
  "exclude": ["src/client.ts"]
}
